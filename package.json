{
    "name": "monorepo",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "setup": "npm install",
        "dev": "concurrently --kill-others --raw \"npm run dev --prefix web\"",
        "build": "npm --workspace web run build && node -e \"const fs=require('fs'); fs.cpSync('web/dist', 'dist', {recursive: true});\"",
        "start": "concurrently --kill-others --raw",
        "lint": "concurrently --raw \"npm run lint --prefix web\""
    },
    "devDependencies": {
        "concurrently": "^10.0.4",
        "knip": "^6.32.1"
    },
    "workspaces": [
        "web"
    ]
}